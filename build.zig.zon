.{
    .name = .weft,
    .version = "0.0.0",
    // Generated once by the Zig toolchain; never changes.
    .fingerprint = 0xfd7f37f6df96dc3b,
    .minimum_zig_version = "0.16.0",
    // Internal libraries resolve to their GitHub release pins by default,
    // so a standalone clone of weft builds with no monorepo around it. The
    // `*_local` twins are the monorepo-iteration path, selected by setting
    // NPINS_OVERRIDE_STEMMA (the same variable npins honors on the nix side;
    // one switch flips both layers; see
    // build.zig's depOrOverride and README "Build"). Everything is lazy:
    // only the selected twin is ever resolved, so a standalone clone never
    // touches the missing ../../lib paths and a monorepo iteration never
    // fetches a tarball. Keep these pins in step with npins/sources.json.
    .dependencies = .{
        .stemma = .{
            .url = "https://github.com/psyclyx/stemma/archive/refs/tags/v0.7.0.tar.gz",
            .hash = "stemma-0.7.0-CIOtoNbqCwBhorsLBBKjaG71e9aIaoS639IXd7mrftgx",
            .lazy = true,
        },
        .stemma_local = .{ .path = "../../lib/stemma", .lazy = true },
        // Skia, compiled from source by build.zig (src/skia/library.zig): the
        // revision nixpkgs' skia pins (chrome m148). googlesource serves any
        // commit as a tarball; build.zig.zon.nix fetches the same tree as
        // the same fetchgit nixpkgs uses, so a Nix build downloads nothing new.
        .skia = .{
            .url = "https://skia.googlesource.com/skia/+archive/e7c90ecca9444fe09598f1630ab7cee2c0ee027a.tar.gz",
            .hash = "N-V-__8AAEYYSwpL-J-F6MwfVmiUdaOSd3CM1ppnpZObRdX8",
        },
        // The VulkanMemoryAllocator revision that Skia's DEPS names for this
        // Skia (`third_party/externals/vulkanmemoryallocator`); header-only.
        // Lazy: only `-Dgpu=vulkan` builds compile Skia's Vulkan backend.
        .vulkan_memory_allocator = .{
            .url = "https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator/archive/a6bfc237255a6bac1513f7c1ebde6d8aed6b5191.tar.gz",
            .hash = "N-V-__8AAHeWOQABqWHSzsYkiKh9vr8y4hszFdUU0OKecnjX",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "config",
        "assets",
        "packaging",
        "README.md",
        "LICENSE",
    },
}
